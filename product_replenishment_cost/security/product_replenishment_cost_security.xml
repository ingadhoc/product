<?xml version="1.0"?>
<odoo noupdate="1">
    <record model="res.groups" id="group_replenishment_rule_expr">
        <field name="name">Allow expressions on Replenishment Cost Rules</field>
    </record>

    <data noupdate="0">
        <record id="replenishment_cost_run_company_rule" model="ir.rule">
            <field name="name">Replenishment Cost Update: multi-company</field>
            <field name="model_id" ref="model_product_replenishment_cost_run"/>
            <field name="domain_force">['|', ('company_ids', '=', False), ('company_ids', 'in', company_ids)]</field>
        </record>

        <record id="replenishment_cost_run_line_company_rule" model="ir.rule">
            <field name="name">Replenishment Cost Update Line: multi-company</field>
            <field name="model_id" ref="model_product_replenishment_cost_run_line"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
