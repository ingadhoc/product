<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_view_tree_catalog_stock" model="ir.ui.view">
        <field name="name">product.view.list.catalog.stock</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product_catalog_tree.product_view_tree_catalog"/>
        <field name="arch" type="xml">
            <!-- Agregar UoM del proveedor después de Order Price -->
            <field name="product_catalog_price" position="after">
                <field name="product_catalog_supplier_uom" optional="show" string="Supplier UoM"/>
            </field>
            <!-- Asegurar que existan los campos de UoM -->
            <xpath expr="//field[@name='uom_id']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <!-- Asegurar que virtual_available esté visible si existe -->
            <xpath expr="//field[@name='virtual_available']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
        </field>
    </record>

</odoo>
