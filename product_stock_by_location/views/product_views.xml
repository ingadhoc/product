<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- product template views -->

        <record id="view_stock_product_template_tree" model="ir.ui.view">
            <field name="name">product.template.stock.list.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="stock.view_stock_product_template_tree"/>
            <field name="arch" type="xml">
                <field name="qty_available" position="after">
                    <button type="object" name="view_stock_detail" invisible="type != 'consu'" icon="zoom_in" groups="base.group_user" title="View Stock Detail"/>
                </field>
            </field>
        </record>

        <record id="product_template_kanban_stock_view" model="ir.ui.view">
            <field name="name">product.template.stock.kanban.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="stock.product_template_kanban_stock_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='qty_available']/ancestor::div[1]" position="after">
                    <div groups="stock.group_stock_user" t-if="record.show_on_hand_qty_status_button.raw_value">
                        <div>Forecasted: <field name="virtual_available"/> <field name="uom_id"/></div>
                        <a type="object" name="view_stock_detail" string="View Stock Detail">
                            View Stock Detail <span class="oi btn btn-group" data-icon="zoom_in"/>
                        </a>
                    </div>
                </xpath>
            </field>
        </record>

        <record id="view_template_stock_by_location_form" model="ir.ui.view">
            <field name="name">product.template stock by location form</field>
            <field name="model">product.template</field>
            <field name="priority">99</field>
            <field name="arch" type="xml">
                <form string="Product Stock by Locations" create="false" edit="false">
                    <field name="id" invisible="1"/>
                    <field name="name" readonly="1"/>
                    <field name="location_ids" context="{'list_view_ref': 'product_stock_by_location.view_location_stock_tree', 'template_id': id}"/>
                </form>
            </field>
        </record>

    <!-- product product views -->

        <record id="view_stock_product_tree" model="ir.ui.view">
            <field name="name">product.product.stock.list.inherit</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="stock.view_stock_product_tree"/>
            <field name="arch" type="xml">
                <field name="qty_available" position="after">
                    <button type="object" name="view_stock_detail" invisible="type != 'consu'" icon="zoom_in" groups="base.group_user" title="View Stock Detail"/>
                </field>
            </field>
        </record>

        <record id="view_product_stock_by_location_form" model="ir.ui.view">
            <field name="name">product.product stock by location form</field>
            <field name="model">product.product</field>
            <field name="mode">primary</field>
            <field name="inherit_id" ref="view_template_stock_by_location_form"/>
            <field name="priority">99</field>
            <field name="arch" type="xml">
                <field name="location_ids" position="attributes">
                    <attribute name="context">{'list_view_ref': 'product_stock_by_location.view_location_stock_tree', 'product_id': id}</attribute>
                </field>
            </field>
        </record>
</odoo>
