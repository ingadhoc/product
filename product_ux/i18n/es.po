#. module: product_ux
#. odoo-python
#: code:addons/product_ux/models/res_config_settings.py:0
msgid ""
"\"%(name)s\" is a %(type)s field. Only text fields and relations can be "
"searched."
msgstr ""
"\"%(name)s\" es un campo %(type)s. Solo se pueden buscar campos de texto y "
"relaciones."

#. module: product_ux
#. odoo-python
#: code:addons/product_ux/models/res_config_settings.py:0
msgid "\"%s\" cannot be searched: it is neither stored nor has a search method."
msgstr ""
"\"%s\" no se puede buscar: no está almacenado ni tiene un método de "
"búsqueda."

#. module: product_ux
#. odoo-python
#: code:addons/product_ux/models/res_config_settings.py:0
msgid ""
"\"%s\" is an HTML field. Searching inside HTML is the main cause of slow "
"searches: use a text field."
msgstr ""
"\"%s\" es un campo HTML. Buscar dentro de HTML es la principal causa de las "
"búsquedas lentas: use un campo de texto."

#. module: product_ux
#. odoo-python
#: code:addons/product_ux/models/res_config_settings.py:0
msgid "\"%s\" is an attachment, it cannot be searched."
msgstr "\"%s\" es un adjunto, no se puede buscar."

#. module: product_ux
#. odoo-python
#: code:addons/product_ux/models/res_config_settings.py:0
msgid "\"%s\" is not a relational field, the path cannot be followed."
msgstr "\"%s\" no es un campo relacional, no se puede seguir el camino."

#. module: product_ux
#. odoo-python
#: code:addons/product_ux/models/res_config_settings.py:0
msgid "\"%s\" is restricted by groups you do not have."
msgstr "\"%s\" está restringido por grupos que usted no tiene."

