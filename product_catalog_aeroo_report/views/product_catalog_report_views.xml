<?xml version="1.0"?>
<odoo>
    <record id="view_product_catalog_report_tree" model="ir.ui.view">
        <field name="name">Product Catalog Reports</field>
        <field name="model">product.product_catalog_report</field>
        <field name="arch" type="xml">
            <list string="Product Catalog Reports">
                <field name="name"/>
                <field name="report_id"/>
                <field name="pricelist_ids"/>
            </list>
        </field>
    </record>

    <record id="view_product_catalog_report_form" model="ir.ui.view">
        <field name="name">Product Catalog Reports</field>
        <field name="model">product.product_catalog_report</field>
        <field name="arch" type="xml">
            <form string="Product Catalog Reports">
                <header>
                    <button name="generate_report" string="Print" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>

                    <group string="Report Output">
                        <group>
                            <field name="report_id"/>
                            <field name="product_type"/>
                            <field name="prod_display_type"
                                invisible="product_type != 'product.template'"
                                required="product_type == 'product.template'"/>
                        </group>
                    </group>

                    <group string="Filters and Content">
                        <group>
                            <field name="only_with_stock" widget="boolean_toggle"/>
                            <field name="taxes_included" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="print_product_uom" widget="boolean_toggle"/>
                            <field name="include_sub_categories" widget="boolean_toggle"/>
                        </group>
                    </group>

                    <group string="Sorting">
                        <group>
                            <field name="categories_order"/>
                        </group>
                        <group>
                            <field name="products_order"/>
                        </group>
                    </group>

                    <group string="Report Scope">
                        <field name="category_ids" widget="many2many_tags" nolabel="0" colspan="2"/>
                        <field name="pricelist_ids" widget="many2many_tags" nolabel="0" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_product_catalog_reports" model="ir.actions.act_window">
        <field name="name">Product Catalog Reports</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.product_catalog_report</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_product_catalog_reports" action="action_product_catalog_reports" parent="sale.prod_config_main" sequence="10"/>
</odoo>
