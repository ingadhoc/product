<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_view_tree_catalog_purchase" model="ir.ui.view">
        <field name="name">product.view.list.catalog.purchase</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product_catalog_tree.product_view_tree_catalog"/>
        <field name="arch" type="xml">
            <field name="product_catalog_price" position="after">
                <field name="product_catalog_supplier_uom" optional="show" string="Supplier UoM"/>
            </field>
        </field>
    </record>

</odoo>
