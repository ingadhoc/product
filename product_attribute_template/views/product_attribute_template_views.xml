<odoo>
    <record id="product_attribute_template_tree_view" model="ir.ui.view">
        <field name="name">product.attribute.template.list.view</field>
        <field name="model">product.attribute.template</field>
        <field name="arch" type="xml">
            <list string="Product Attribute Template">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="attribute_template_action_view">
        <field name="name">Products attributes templates</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.attribute.template</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="product_attribute_template_tree_view"/>
    </record>

    <menuitem id="menu_product_attribute_template" parent="sale.product_menu_catalog" sequence="35"
          action="attribute_template_action_view" groups="sales_team.group_sale_manager"/>


    <record id="product_attribute_template_form_view" model="ir.ui.view">
        <field name="name">product.attribute.template.form.view</field>
        <field name="model">product.attribute.template</field>
        <field name="arch" type="xml">
            <form string="">
                <header>
                    <button string="Update attributes on products" type="object" name="update_attributes" confirm="The missing attribute lines will be created on every product of this template. This cannot be undone. Do you want to continue?"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button"
                            name="action_view_products"
                            icon="view_list"
                            type="object">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="product_qty"/></span>
                                <span class="o_stat_text">Products</span>
                            </div>
                        </button>
                         <button class="oe_stat_button"
                            name="action_view_not_configured_products"
                            icon="view_list"
                            type="object">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="not_configured_product_qty"/></span>
                                <span class="o_stat_text">Not configured</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label class="oe_edit_only" for="name" string="Template Name"/>
                        <h1><field name="name" placeholder="Template Name"/></h1>
                    </div>
                    <group>
                        <field name="product_attribute_ids" widget="many2many_tags"/>
                    </group>
                    <group>
                        <field name="line_ids">
                            <list editable="bottom" create="false" delete="false">
                                <field name="product_tmpl_id" readonly="1"/>
                                <field name="attribute_id" readonly="1" no_open="True"/>
                                <field name="value_ids" widget="many2many_tags" domain="[('attribute_id', '=', attribute_id)]" context="{'default_attribute_id': attribute_id}"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
