<?xml version="1.0"?>
<odoo noupdate="1">
<!-- grupos y categoria de grupos-->

    <record model="res.groups.privilege" id="module_prices_management">
        <field name="name">Restricción de precios</field>
        <field name="sequence">1</field>
        <field name="category_id" ref="base.module_category_tools"/>
    </record>

        <record model="res.groups" id="group_only_view">
            <field name="privilege_id" ref="module_prices_management"/>
            <field name="name">Solo ver: precio venta y compra</field>
        </record>

        <record model="res.groups" id="group_only_view_sale_price">
            <field name="privilege_id" ref="module_prices_management"/>
            <field name="implied_ids" eval="[(4, ref('group_only_view'))]"/>
            <field name="name">Solo ver: precio de venta</field>
        </record>
<!-- reglas: en 20 una restriccion global con el dominio condicionado al grupo,
     porque los permisos de ir.access se suman por grupo y no se pueden restar -->

    <!-- hacemos readonly a lo payment terms -->
    <record id="restrict_price_read_only_payment_term" model="ir.access">
        <field name="name">Restrict Price Read Only on Payment Term</field>
        <field name="model_id" ref="account.model_account_payment_term" />
        <field name="operation">cud</field>
        <field name="domain">[('name', '=', False)] if user.has_group('price_security.group_only_view') else []</field>
    </record>

    <!-- hacemos readonly a los pricelists -->
    <record id="restrict_price_read_only_pricelist" model="ir.access">
        <field name="name">Restrict Price Read Only on Pricelist</field>
        <field name="model_id" ref="product.model_product_pricelist" />
        <field name="operation">cud</field>
        <field name="domain">[('name', '=', False)] if user.has_group('price_security.group_only_view') else []</field>
    </record>

    <!-- hacemos readonly a las reglas de los pricelists -->
    <record id="restrict_price_read_only_pricelist_item" model="ir.access">
        <field name="name">Restrict Price Read Only on Pricelist Item</field>
        <field name="model_id" ref="product.model_product_pricelist_item" />
        <field name="operation">cud</field>
        <field name="domain">[(0, '=', 1)] if user.has_group('price_security.group_only_view') else []</field>
    </record>
</odoo>
